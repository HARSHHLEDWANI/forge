# Copy to .env (gitignored) in this directory and fill in real values
# before running `docker compose -f docker-compose.prod.yml up -d --build`.

# A domain name that already resolves (A/AAAA record) to this server's
# public IP — Caddy requests a Let's Encrypt certificate for exactly
# this name and won't succeed until DNS is actually pointing here.
FORGE_DOMAIN=forge.example.com

# A real, random password — this goes straight into postgres's
# POSTGRES_PASSWORD and forge-server/forge-worker's FORGE_DATABASE_URL.
FORGE_DB_PASSWORD=change-me
